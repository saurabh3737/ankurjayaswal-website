# Public URL of the site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://ankurjayaswal.com

# Contact form email delivery via Resend (https://resend.com) — free tier is plenty.
# Without these the form shows a friendly "email me directly" message instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ankur.dublin@gmail.com
# Must be a sender on a domain you verified in Resend. Until then, use Resend's test sender:
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>
